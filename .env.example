# Папка на компьютере с фото и видео (только чтение, файлы не удаляются)
SOURCE_DIR=

# Число параллельных потоков загрузки (1..3, по умолчанию 2)
MAX_WORKERS=2

# Размер чанка для возобновляемой загрузки больших видео (МБ, 4..64)
CHUNK_MB=16

# Защита основной квоты: 1 — останавливаться, если растёт занятое обычное место Диска
STRICT_QUOTA_GUARD=1

# Автонаблюдение за папкой (0 — разовый прогон, 1 — следить за новыми файлами)
WATCH_MODE=0
WATCH_INTERVAL_SEC=60
